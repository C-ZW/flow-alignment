    { "id": "obs-horizontal-shell", "kind": "observed", "summary": "The desktop site uses a single horizontal shell: brand at left, About/Add record/Dashboard tabs centered, and language/data-year controls at right; on mobile the shell wraps into a compact top row and tab row.", "evidence": ["ev-landing-desktop-shot", "ev-landing-mobile-shot"] },
    { "id": "obs-landing-hero", "kind": "observed", "summary": "The landing page leads with a large border-work headline, a short explanation, data-year/economy/industry facts, and an Add a purchase call to action.", "evidence": ["ev-landing-desktop-shot", "ev-landing-mobile-shot"] },
    { "id": "obs-landing-sections", "kind": "observed", "summary": "Below the hero, a dark How it works band presents three numbered cards, followed by an estimate-method note, browser-storage/privacy note, and footer links.", "evidence": ["ev-landing-desktop-full-shot", "ev-landing-mobile-full-shot"] },
    { "id": "obs-input-layout", "kind": "observed", "summary": "The Add record route opens a two-column workspace on desktop: a white purchase form on the left and a dark estimate panel on the right; the mobile view reflows the same surfaces into a vertical sequence.", "evidence": ["ev-input-desktop-shot", "ev-input-mobile-shot"] },
    { "id": "obs-category-picker", "kind": "observed", "summary": "The purchase form starts with a country selector and an eight-item area-of-life grid; choosing Food & drink replaces that grid with a Back control and three food item choices.", "evidence": ["ev-input-desktop-shot", "ev-item-picker-desktop-shot", "ev-food-desktop", "ev-item-picker-mobile-shot", "ev-food-mobile"] },
    { "id": "obs-estimate-result", "kind": "observed", "summary": "After choosing Coffee & drinks and entering 12 USD, the result panel shows about 18 minutes, a 11–29 minute likely range, five leading industries, and a regional breakdown.", "evidence": ["ev-amount-form-desktop-shot", "ev-estimate-desktop-shot", "ev-estimate-mobile-shot", "ev-amount-desktop", "ev-amount-mobile"] },
    { "id": "obs-saved-record", "kind": "observed", "summary": "Submitting Save this record changes the result to SAVED, adds a Recent records row for the coffee purchase, and exposes View dashboard; the URL remains #input.", "evidence": ["ev-save-desktop", "ev-save-mobile", "ev-saved-result-desktop-shot", "ev-saved-result-mobile-shot"] },
